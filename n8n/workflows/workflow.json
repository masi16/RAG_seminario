    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst pregunta = $('Webhook').first().json.body.pregunta;\nconst fragmentos = $input.first().json.resultados || [];\n\nconst contexto = fragmentos.map((f, i) => {\n  const m = f.metadata || {};\n  return `[${i + 1}] (${m.documento || 'documento'}, ${m.articulo || ''} p. ${m.pagina || '?'})\\n${f.texto}`;\n}).join('\\n\\n');\n\nconst prompt = `Sos un asistente académico de la UNLaR. Respondé en español usando SOLO el contexto de abajo. Si la respuesta no está en el contexto, decí que no la encontraste en los documentos. Citá el documento y artículo.\n\nCONTEXTO:\n${contexto}\n\nPREGUNTA: ${pregunta}`;\n\nreturn [{ json: { pregunta, fragmentos, messages: [{ role: 'user', content: prompt }] } }];"
      },
